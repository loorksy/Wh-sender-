<?xml version="1.0" encoding="utf-8"?>
<!--
    Popup panel design tokens — LIGHT.
    Dark values live in values-night/panel_colors.xml (same names), so the panel
    follows the system theme exactly like WhatsApp underneath it.
-->
<resources>
    <!-- Surfaces -->
    <color name="panel_surface">#FFFFFF</color>
    <color name="panel_card_stroke">#12000000</color>
    <color name="panel_field">#F3F4F6</color>
    <color name="panel_field_stroke">#E6E8EB</color>
    <color name="panel_chip">#FFFFFF</color>
    <color name="panel_chip_stroke">#E1E4E8</color>
    <color name="panel_segment_on">#FFFFFF</color>
    <color name="panel_segment_on_stroke">#E1E4E8</color>
    <color name="panel_ripple">#14000000</color>

    <!-- Text -->
    <color name="panel_text">#111418</color>
    <color name="panel_text2">#5B6470</color>
    <color name="panel_text3">#7C8591</color>

    <!-- Accent (teal, from the app's blue→green brand) -->
    <color name="panel_accent">#0E857A</color>
    <color name="panel_on_accent">#FFFFFF</color>
    <color name="panel_accent_soft">#E3F3F0</color>
    <color name="panel_accent_text">#0A6E65</color>
    <color name="panel_on_accent_ripple">#33FFFFFF</color>
    <color name="panel_text_highlight">#330E857A</color>

    <!-- Slider -->
    <color name="panel_seek_track">#E3E6EA</color>

    <!-- Success screen -->
    <color name="panel_success_bg">#E8F6EE</color>
    <color name="panel_success">#16A34A</color>
    <color name="panel_on_success">#FFFFFF</color>

    <!-- Floating bubble -->
    <color name="panel_bubble_bg">#FFFFFF</color>
    <color name="panel_bubble_stroke">#17000000</color>
</resources>
