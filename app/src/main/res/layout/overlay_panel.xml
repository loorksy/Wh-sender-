<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_brand_circle"
            android:padding="5dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_plane" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bulk_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClosePanel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bulk_hint"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/textSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_success"
        android:padding="12dp"
        android:textColor="@color/success_text"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/paste_messages"
        android:textColor="@color/text_muted"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputMessages"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/paste_hint"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_count"
        android:padding="10dp"
        android:text="@string/message_count_zero"
        android:textColor="@color/chip_text"
        android:textStyle="bold"
        android:visibility="visible" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mpm_label"
        android:textColor="@color/text_muted"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMpmValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="100"
        android:textColor="@color/accent_strong"
        android:textSize="22sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/seekMpm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="999"
        android:progress="99"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/chip10"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/surface_alt"
            android:textColor="@color/text_primary"
            android:text="10"
            android:textSize="12sp" />

        <Button
            android:id="@+id/chip60"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/surface_alt"
            android:textColor="@color/text_primary"
            android:text="60"
            android:textSize="12sp" />

        <Button
            android:id="@+id/chip300"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/surface_alt"
            android:textColor="@color/text_primary"
            android:text="300"
            android:textSize="12sp" />

        <Button
            android:id="@+id/chip1000"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:backgroundTint="@color/surface_alt"
            android:textColor="@color/text_primary"
            android:text="1000"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/status_idle"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/accent"
        android:text="@string/send"
        android:textColor="@color/on_accent"
        android:textSize="16sp" />
</LinearLayout>
