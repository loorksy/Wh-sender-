<?xml version="1.0" encoding="utf-8"?>
<!--
    Popup send panel (shown over WhatsApp when the floating bubble is tapped).

    Two modes inside one card:
      • formView    – compose + rate + send (default)
      • successView – full success screen once a run finishes (BulkState.DONE)

    Layout is always RTL: every string in the app is Arabic, so the panel reads
    right-to-left even on devices set to a non-Arabic language.
    Light / dark come from values/ and values-night/panel_colors.xml.
    Views are wired in FloatingBubbleService.showPanel().
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layoutDirection="rtl"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═════════════════════ FORM MODE ═════════════════════ -->
        <!-- Extends 13dp into the card padding on both sides (and pads it back) so the
             slider below can line its track up with the content edges and still be touchable. -->
        <LinearLayout
            android:id="@+id/formView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-13dp"
            android:layout_marginEnd="-13dp"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <!-- Top row: split-mode tabs · close (same level) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_panel_track"
                    android:contentDescription="@string/split_mode_desc"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/segPara"
                        style="@style/PanelText.Segment"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="64dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/split_para" />

                    <TextView
                        android:id="@+id/segLine"
                        style="@style/PanelText.Segment"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="64dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/split_line" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnClosePanel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_panel_icon_btn"
                    android:clickable="true"
                    android:contentDescription="@string/close"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/panel_text2" />
            </LinearLayout>

            <!-- Message field (outline turns accent while typing) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_panel_field"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/inputMessages"
                    style="@style/PanelText.Input"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/paste_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="0dp"
                    android:scrollbars="vertical"
                    android:textCursorDrawable="@drawable/panel_cursor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPaste"
                        style="@style/PanelText.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_panel_chip"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_paste"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/panel_text2"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:text="@string/paste" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/PanelText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/count_label" />

                    <TextView
                        android:id="@+id/textCount"
                        style="@style/PanelText.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_panel_badge"
                        android:gravity="center"
                        android:minWidth="34dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/message_count_zero" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/PanelText.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mpm_label" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textMpmValue"
                        style="@style/PanelText.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="300" />

                    <TextView
                        style="@style/PanelText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/mpm_unit" />
                </LinearLayout>
            </LinearLayout>

            <!-- Logarithmic rate slider; negative margins line the track up with the content edges -->
            <SeekBar
                android:id="@+id/seekMpm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-13dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="-13dp"
                android:max="1000"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:mirrorForRtl="true"
                android:paddingStart="13dp"
                android:paddingTop="4dp"
                android:paddingEnd="13dp"
                android:paddingBottom="4dp"
                android:progress="826"
                android:progressDrawable="@drawable/panel_seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/panel_seek_thumb" />

            <!-- Rate presets (segmented, ascending from the right like the slider) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/chip10"
                    style="@style/PanelText.Segment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="10" />

                <TextView
                    android:id="@+id/chip60"
                    style="@style/PanelText.Segment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="60" />

                <TextView
                    android:id="@+id/chip300"
                    style="@style/PanelText.Segment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="300" />

                <TextView
                    android:id="@+id/chip1000"
                    style="@style/PanelText.Segment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="1000" />
            </LinearLayout>

            <!-- Primary action; while a run is in progress it turns grey and shows the live status -->
            <TextView
                android:id="@+id/btnSend"
                style="@style/PanelText.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_panel_send"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/send" />
        </LinearLayout>

        <!-- ════════════════════ SUCCESS MODE ════════════════════ -->
        <LinearLayout
            android:id="@+id/successView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:visibility="gone">

            <!-- Check mark: solid disc inside a soft halo -->
            <FrameLayout
                android:id="@+id/successBadge"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_panel_success_halo">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_panel_success_disc"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_check"
                    android:tint="@color/panel_on_success" />
            </FrameLayout>

            <TextView
                style="@style/PanelText.SuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/success_title" />

            <TextView
                style="@style/PanelText.SuccessBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/success_subtitle" />

            <!-- Summary tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_tile"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/textSuccessCount"
                        style="@style/PanelText.Stat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/message_count_zero" />

                    <TextView
                        style="@style/PanelText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/success_sent_label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_tile"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/textSuccessRate"
                        style="@style/PanelText.Stat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/message_count_zero" />

                    <TextView
                        style="@style/PanelText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mpm_unit" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSendAgain"
                style="@style/PanelText.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_panel_send"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/send_again" />

            <TextView
                android:id="@+id/btnSuccessClose"
                style="@style/PanelText.ButtonQuiet"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_panel_quiet_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
