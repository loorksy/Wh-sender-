<?xml version="1.0" encoding="utf-8"?>
<!-- Message-count badge: neutral at 0, accent once there is something to send (state_activated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_accent_soft" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_chip" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="@color/panel_chip_stroke" />
        </shape>
    </item>
</selector>
