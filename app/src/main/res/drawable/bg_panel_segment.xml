<?xml version="1.0" encoding="utf-8"?>
<!-- One segment of a segmented control; selected = raised pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/panel_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/panel_segment_on" />
                    <corners android:radius="100dp" />
                    <stroke android:width="1dp" android:color="@color/panel_segment_on_stroke" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
