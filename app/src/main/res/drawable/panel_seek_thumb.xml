<?xml version="1.0" encoding="utf-8"?>
<!-- Accent knob with a surface-coloured ring that cuts the track (gap style). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/panel_surface" />
            <size android:width="26dp" android:height="26dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/panel_accent" />
        </shape>
    </item>
</layer-list>
